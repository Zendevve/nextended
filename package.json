{
  "name": "nexus-download-tools",
  "version": "0.1.0",
  "description": "Restores and improves download controls for archived Nexus Mods files.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write src scripts tests",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.5.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
