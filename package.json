{
  "name": "nexus-download-tools",
  "version": "0.1.0",
  "description": "Restores and improves download controls for archived Nexus Mods files, collections, and mod requirements.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --chrome",
    "build:firefox": "node scripts/build.mjs --firefox",
    "dev": "node scripts/build.mjs --watch",
    "dev:chrome": "node scripts/build.mjs --chrome --watch",
    "dev:firefox": "node scripts/build.mjs --firefox --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write src scripts tests",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.22.0",
    "globals": "^14.0.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.5.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
